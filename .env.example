# Set to "true" to show the "Get in touch" form; otherwise the button opens an email.
# Read at build time, so redeploy after changing it.
NEXT_PUBLIC_CONTACT_FORM_ENABLED=
# Inbox that receives "Get in touch" messages. Leave empty to keep the form disconnected.
CONTACT_TO_EMAIL=
# API key for the email provider (Resend). Both values are required to enable delivery.
RESEND_API_KEY=
